@page "/read/{Key}/universe"
@page "/read/{Key}"
@page "/read/{Key}/chapter/{Chapter:int}"
@page "/read/{Key}/chapter/{Chapter:int}/verse/{Verse:int}"
@page "/read/{Key}/concept/{Concept}"
@page "/read/{Key}/journey/{Journey}"
@page "/read/{Key}/search"
<ReadSurface Key="@Key" Chapter="@Chapter" Verse="@Verse" Concept="@Concept" Journey="@Journey" Query="@Query" Locale="@Locale" Audience="@Audience" />
@code {
    [Parameter] public string Key { get; set; } = "";
    [Parameter] public int? Chapter { get; set; }
    [Parameter] public int? Verse { get; set; }
    [Parameter] public string? Concept { get; set; }
    [Parameter] public string? Journey { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "locale")] public string? Locale { get; set; }
    [SupplyParameterFromQuery(Name = "audience")] public Guid? Audience { get; set; }
}
