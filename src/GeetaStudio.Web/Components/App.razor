<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @if (!Reading) { <ResourcePreloader /> }
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["GeetaStudio.Web.styles.css"]" />
    <link rel="stylesheet" href="@Assets["read.css"]" />
    <script src="@Assets["read.js"]" defer></script>
    @if (!Reading) { <ImportMap /> }
    <HeadOutlet />
</head>

<body>
    <Routes />
    @if (!Reading) { <ReconnectModal /><script src="@Assets["_framework/blazor.web.js"]"></script> }
</body>

</html>

@code {
    [CascadingParameter] public HttpContext? Http { get; set; }
    private bool Reading => Http?.Request.Path == "/" || Http?.Request.Path.StartsWithSegments("/read") == true || Http?.Request.Path.StartsWithSegments("/preview") == true;
}
