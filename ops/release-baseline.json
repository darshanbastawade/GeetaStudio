      "alert": "5xx >1% for 5 minutes or readiness fails twice"
    },
    "readerP95Ms": {
      "target": 1000,
      "alert": "p95 >1000ms for 5 minutes"
    },
    "queueDelaySeconds": {
      "target": 120,
